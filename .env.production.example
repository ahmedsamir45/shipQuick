# Django Settings
SECRET_KEY=your-secret-key-here-generate-a-strong-one
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,your-server-ip

# Database Configuration (PostgreSQL)
DB_ENGINE=postgresql
DB_NAME=shipping_db
DB_USER=shipping_user
DB_PASSWORD=your-strong-database-password
DB_HOST=localhost
DB_PORT=5432

# CORS Settings
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# SSL/Security Settings
SECURE_SSL_REDIRECT=True

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/shipping_platform.log

# Optional: Address Validation API Keys (if using)
USPS_API_KEY=
USPS_USER_ID=
GOOGLE_MAPS_API_KEY=
SMARTY_AUTH_ID=
SMARTY_AUTH_TOKEN=
LOB_API_KEY=

# Primary and Fallback Address Validators
PRIMARY_ADDRESS_VALIDATOR=usps
FALLBACK_ADDRESS_VALIDATOR=google
