# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-backend-domain.com

# Database Configuration
# Use 'sqlite' for development or 'postgresql' for production
DB_ENGINE=postgresql

# PostgreSQL Configuration (for production)
DB_NAME=your-database-name
DB_USER=your-database-user
DB_PASSWORD=your-database-password
DB_HOST=your-database-host.aivencloud.com
DB_PORT=your-database-port
DB_SSLMODE=require

# Address Validation APIs
# Primary provider (USPS, Google, Smarty, or Lob)
PRIMARY_ADDRESS_VALIDATOR=usps
USPS_API_KEY=your-usps-api-key-here
USPS_USER_ID=your-usps-user-id-here

# Fallback provider
FALLBACK_ADDRESS_VALIDATOR=google
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Alternative providers (optional)
SMARTY_AUTH_ID=your-smarty-auth-id-here
SMARTY_AUTH_TOKEN=your-smarty-auth-token-here
LOB_API_KEY=your-lob-api-key-here

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/shipping_platform.log

# CORS Configuration
# Add your Vercel deployment URL here after deploying
# Format: https://your-app.vercel.app,https://your-app-git-main.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-app.vercel.app

# Optional: Set to True to allow all origins (only for development/testing)
# CORS_ALLOW_ALL_ORIGINS=False
